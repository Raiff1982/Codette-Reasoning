#!/usr/bin/env bash
# Codette pre-push hook
#
# Runs cocoon-smoke when forge/cocoon-related code changes are pushed.
#
# Install:
#   cp .githooks/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# Skip once:
#   git push --no-verify

set -euo pipefail

WATCH_REGEX='^(
reasoning_forge/|
inference/codette_forge_bridge\.py$|
inference/codette_server\.py$|
scripts/cocoon_smoke\.py$|
reasoning_forge/cocoon_.*\.py$
)'

# Ensure prerequisites exist
if ! command -v git >/dev/null 2>&1; then
    echo "[pre-push] git not found"
    exit 1
fi

if ! command -v make >/dev/null 2>&1; then
    echo "[pre-push] make not found"
    exit 1
fi

changed_files=""

# Git supplies refs on stdin:
# <local-ref> <local-sha> <remote-ref> <remote-sha>
while read -r local_ref local_sha remote_ref remote_sha; do

    # New branch push
    if [[ "$remote_sha" == "0000000000000000000000000000000000000000" ]]; then
        range="$local_sha"
    else
        range="${remote_sha}..${local_sha}"
    fi

    diff_files=$(git diff --name-only "$range" 2>/dev/null || true)

    if [[ -n "$diff_files" ]]; then
        changed_files+=$'\n'
        changed_files+="$diff_files"
    fi

done

# No files found
if [[ -z "$changed_files" ]]; then
    exit 0
fi

# Trigger only on watched files
if ! echo "$changed_files" | grep -Eq "$WATCH_REGEX"; then
    exit 0
fi

echo
echo "  [pre-push] Forge/cocoon files changed."
echo "  [pre-push] Running: make cocoon-smoke"
echo "  [pre-push] Skip with: git push --no-verify"
echo

if ! make cocoon-smoke; then
    echo
    echo "  [pre-push] BLOCKED: cocoon-smoke failed."
    echo "  Fix the integrity issues above before pushing."
    echo "  To bypass: git push --no-verify"
    echo
    exit 1
fi

echo "  [pre-push] cocoon-smoke passed."
exit 0
